PORT = 

MODEL_AGENTE_NAME = 

# cpu: sem quantização (padrão). cuda: GPU CUDA com quantização de 4 bits.
# auto: CUDA quando disponível; caso contrário, CPU.
LLM_DEVICE=cpu

HOST='localhost'
REDIS_PORT = 6379
REDIS_DB = 0

# Chave secreta para HMAC. Não compartilhe esta chave publicamente.
SECRET_KEY =

# Neo4j: URI Bolt/Neo4j do banco (não é a URL do Neo4j Browser).
# Ex.: neo4j+s://SEU-BANCO.databases.neo4j.io ou bolt://localhost:7687
NEO4J_URI=
NEO4J_USER=neo4j
# NEO4J_USERNAME também é aceito para compatibilidade; NEO4J_USER tem prioridade.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT=8
NEO4J_MAX_HOPS=15
NEO4J_ALLOWED_DOMAINS=puc-campinas.edu.br

# Esquema do crawler: (:Pagina {url, descricao, html, restrita})-[:LINKA_PARA]->(:Pagina)
NEO4J_PAGE_LABEL=Pagina
NEO4J_URL_PROPERTY=url
NEO4J_TITLE_PROPERTY=descricao
NEO4J_HTML_PROPERTY=html
NEO4J_RESTRICTED_PROPERTY=restrita
NEO4J_LINK_RELATION=LINKA_PARA
# O crawler não cria texto separado nem texto de âncora nas relações.
NEO4J_TEXT_PROPERTY=
NEO4J_LINK_TEXT_PROPERTY=
